# ─────────────────────────────────────────────────────────────────────────────
# FitFlow AI Service — Environment Variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://fitflow:fitflow_dev_password@localhost:5432/fitflow_dev

# LLM provider — swap by changing the adapter in app/llm/provider.py
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=fitflow-media-dev

# Feature flags
ENABLE_PGVECTOR=true

CORS_ORIGINS=http://localhost:3000
