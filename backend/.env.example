# ─────────────────────────────────────────────────────────────────────────────
# FitFlow Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL (local dev: use docker-compose.yml values)
DATABASE_URL=postgresql://fitflow:fitflow_dev_password@localhost:5432/fitflow_dev
TYPEORM_SYNC=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT (used for signing internal tokens if any — Cognito JWKS used for verification)
JWT_SECRET=change-me-in-production

# Amazon Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id

# AI microservice
AI_SERVICE_URL=http://ai-service:8000

# AWS S3
S3_BUCKET_NAME=fitflow-media-dev
S3_REGION=us-east-1

# AWS SQS/SNS
SQS_PLAN_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/fitflow-plans-dev
SNS_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fitflow-notifications-dev
